{
  "Agent": {
    "ShopId": "demo-shop-id",
    "DeviceId": "VELOX-DEMO-AGENT-01",
    "DeviceKey": "agent_secret_key_demo_2026",
    "DeviceName": "VELOX-DEMO-AGENT-01",
    "ApiUrl": "http://localhost:5000",
    "WsUrl": "http://localhost:5000/agent",
    "DownloadPath": "./downloads",
    "TempPath": "./temp",
    "DataPath": "./data",
    "LogLevel": "Information",
    "HeartbeatIntervalSeconds": 30,
    "MaxReconnectDelaySeconds": 30
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "logs/velox-agent-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      }
    ]
  }
}
