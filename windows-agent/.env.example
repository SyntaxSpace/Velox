# Velox Windows Edge Agent — Environment Configuration Example
# Copy to .env or set environment variables in Windows system

# The UUID of the shop this agent belongs to (must match Shop record in backend)
VELOX_Agent__ShopId=your-shop-uuid-here

# Unique device identifier registered for this shop
VELOX_Agent__DeviceId=VELOX-DEMO-AGENT-01

# Secret device authentication key shared with backend
VELOX_Agent__DeviceKey=your-device-key-here

# Friendly hostname/workstation name
VELOX_Agent__DeviceName=VELOX-DEMO-AGENT-01

# Velox Cloud / Backend REST API URL
VELOX_Agent__ApiUrl=http://localhost:5000

# Velox WebSocket Gateway URL (Socket.IO /agent namespace)
VELOX_Agent__WsUrl=http://localhost:5000/agent

# Heartbeat interval in seconds
VELOX_Agent__HeartbeatIntervalSeconds=30

# Logging level: Verbose, Debug, Information, Warning, Error, Fatal
VELOX_Agent__LogLevel=Information
