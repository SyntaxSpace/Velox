# ═══════════════════════════════════════════════════════════════
# Velox .gitignore
# ═══════════════════════════════════════════════════════════════

# ─── Dependencies ─────────────────────────────────────────────
node_modules/
.pnp
.pnp.js

# ─── Build Outputs ───────────────────────────────────────────
dist/
build/
out/
.next/
*.tsbuildinfo

# ─── Environment Files ──────────────────────────────────────
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.production

# ─── IDE ─────────────────────────────────────────────────────
.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Testing ─────────────────────────────────────────────────
coverage/
.nyc_output/

# ─── Logs ────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ─── .NET / Windows Agent ────────────────────────────────────
windows-agent/bin/
windows-agent/obj/
*.suo
*.user
*.userosscache
*.sln.docstates

# ─── Prisma ──────────────────────────────────────────────────
prisma/migrations/**/migration_lock.toml

# ─── Docker ──────────────────────────────────────────────────
docker-compose.override.yml

# ─── Misc ────────────────────────────────────────────────────
*.tgz
.cache
.temp
.tmp
