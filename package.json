{
  "name": "velox-root",
  "version": "1.0.0",
  "private": true,
  "description": "Velox — QR-based Smart Printing Platform",
  "workspaces": [
    "frontend",
    "backend",
    "shared"
  ],
  "scripts": {
    "prepare": "husky",
    "lint": "npm run lint --workspaces --if-present",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\"",
    "build": "npm run build --workspaces --if-present",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:agent": "dotnet run --project windows-agent/VeloxAgent.csproj",
    "db:start": "node scripts/start-postgres.js",
    "db:migrate": "npm run prisma:migrate --workspace=backend",
    "db:migrate:deploy": "npm run prisma:migrate:deploy --workspace=backend",
    "db:generate": "npm run prisma:generate --workspace=backend",
    "db:bootstrap:partner": "npm run bootstrap:partner --workspace=backend",
    "db:seed": "npm run seed --workspace=backend",
    "demo:reset": "node scripts/demo-reset.js"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.7.0",
    "@commitlint/config-conventional": "^19.7.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "embedded-postgres": "^18.4.0-beta.17"
  }
}
