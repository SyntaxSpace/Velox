<Window x:Class="VeloxAgent.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Velox Agent"
        Width="420" Height="600"
        MinWidth="380" MinHeight="480"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen">
    <Border Background="White"
            CornerRadius="12"
            BorderBrush="#E5E5E5"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.12" Color="#000000" />
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Custom Title Bar for drag -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,8,0">
                    <Button Content="─" Click="MinimizeButton_Click"
                            Width="32" Height="28" FontSize="12"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#737373" Cursor="Hand" />
                    <Button Content="✕" Click="CloseButton_Click"
                            Width="32" Height="28" FontSize="12"
                            Background="Transparent" BorderThickness="0"
                            Foreground="#737373" Cursor="Hand" />
                </StackPanel>
            </Grid>

            <!-- WebView2 Content -->
            <wv2:WebView2 x:Name="WebView" Grid.Row="1"
                          DefaultBackgroundColor="White" />
        </Grid>
    </Border>
</Window>
