# ═══════════════════════════════════════════════════════════════
# Velox Backend — Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env and fill in the values.
# NEVER commit .env with real secrets.
# ═══════════════════════════════════════════════════════════════

# ─── Server ──────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── Database (PostgreSQL) ──────────────────────────────────
DATABASE_URL=postgresql://velox:velox_dev@localhost:5432/velox_dev

# ─── Authentication (JWT) ───────────────────────────────────
JWT_SECRET=your-jwt-secret-here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── CORS ────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── File Storage (Future: S3 / Cloudflare R2) ─────────────
# S3_BUCKET=
# S3_REGION=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=

# ─── Payments (Future: Razorpay) ────────────────────────────
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=

# ─── Socket.IO ───────────────────────────────────────────────
# SOCKET_PORT=5000  (uses same port as Express by default)

# ─── Redis (Future) ─────────────────────────────────────────
# REDIS_URL=redis://localhost:6379

# ─── Logging ─────────────────────────────────────────────────
LOG_LEVEL=debug
