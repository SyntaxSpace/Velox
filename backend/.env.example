NODE_ENV=development
PORT=5000
HOST=127.0.0.1
DATABASE_URL=postgresql://user:password@localhost:5432/velox_dev
DIRECT_URL=postgresql://user:password@localhost:5432/velox_dev
JWT_SECRET=your-jwt-secret-min-32-characters
JWT_REFRESH_SECRET=your-refresh-secret-min-32-characters
CORS_ORIGIN=http://localhost:3000
UPLOAD_DIR=./uploads
UPLOAD_STORAGE=local
# For production Storage mode, set UPLOAD_STORAGE=supabase and configure these in the host's secret settings:
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=<server-only secret key>
# SUPABASE_STORAGE_BUCKET=velox-print-documents
